# /etc/logiforge/logiforge.env の見本。serve と worker が、同じファイルを読む（EnvironmentFile）。
# 秘密は書かない。秘密は /etc/logiforge/secrets/ に置き、ユニットの LoadCredential で渡す。
# 中身の正本は design/deploy/env.md。手順は docs/adoption/linux-host/README.md に書く。

LOGIFORGE_GITFORGE=github
LOGIFORGE_GITHUB_REPOSITORIES=myapp-cache-strategy=acme/myapp-cache-strategy
# 読むだけの GitHub App の App ID。秘密鍵は /etc/logiforge/secrets/github_app_key.pem に置く。
LOGIFORGE_GITHUB_APP_ID=<App ID>

# user とみなすアカウント（どちらか、または両方）
LOGIFORGE_USER_TEAM=acme/logiforge-users
#LOGIFORGE_USER_LOGINS=alice,bob

# WebUI のサインイン。OAuth App の Authorization callback URL と同じにする。
LOGIFORGE_OAUTH_CLIENT_ID=<Client ID>
LOGIFORGE_OAUTH_REDIRECT_URI=https://<host>.<tailnet>.ts.net/oauth/callback

# logiforge record-public-keys の出力。秘密ではない。
LOGIFORGE_RECORD_PUBLIC_KEYS=<鍵の ID=base64>

# 置き場と clone。ユニットの StateDirectory と同じ場所にする。
LOGIFORGE_STORE_DIR=/var/lib/logiforge/store
LOGIFORGE_WORKER_DIR=/var/lib/logiforge/worker

# GitHub の REST の上限に合わせた間隔（design/adapters/github.md の「見回りの間隔」）
LOGIFORGE_WORKER_INTERVAL=10s
LOGIFORGE_WORKER_RECORD_INTERVAL=30s
