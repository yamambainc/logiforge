# /etc/logiforge/logiforge.env の見本。serve と worker が、同じファイルを読む（EnvironmentFile）。
# 起動時に渡すのは、設定の DB の場所と、ホストに結び付くものだけである。鍵は書かない（/etc/logiforge/secrets/ に置き、ユニットの LoadCredential で渡す）。
# ほかの設定（GitHub App、repository、間隔など）は、設定の DB に置き、WebUI のセットアップと設定の画面で変える。
# 中身の正本は design/deploy/env.md。手順は docs/adoption/linux-host/README.md に書く。

LOGIFORGE_DB=/var/lib/logiforge/config/settings.db

# 置き場と clone。ユニットの ReadWritePaths と同じ場所にする。
LOGIFORGE_STORE_DIR=/var/lib/logiforge/store
LOGIFORGE_WORKER_DIR=/var/lib/logiforge/worker
