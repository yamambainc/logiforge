# Logiforge のバックエンド（logiforge serve）。127.0.0.1:8080 で待ち受け、tailscale serve が https で公開する。
# 手順と理由は docs/adoption/linux-host/README.md に書く。systemd 251 以上で動く（%d を使うため）。
[Unit]
Description=Logiforge backend
Documentation=https://github.com/yamambainc/logiforge/blob/main/docs/adoption/linux-host/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=logiforge
Group=logiforge
EnvironmentFile=/etc/logiforge/logiforge.env
# 鍵は、/etc/logiforge/secrets/ のファイルを systemd が写したものを、_FILE で渡す。バックエンドは 2 つの鍵を持つ。
# ほかの設定と秘密は、設定の DB に置く（design/settings/README.md）。
LoadCredential=backend_key:/etc/logiforge/secrets/backend_key
LoadCredential=shared_key:/etc/logiforge/secrets/shared_key
Environment=LOGIFORGE_BACKEND_KEY_FILE=%d/backend_key
Environment=LOGIFORGE_SHARED_KEY_FILE=%d/shared_key
# tailnet の外から直接届かないように、ループバックだけで待ち受ける。
Environment=LOGIFORGE_ADDR=127.0.0.1:8080
# 作業用の git の複製を置く。起動のときに、古い複製を消す（design/deploy/kubernetes.md）。
Environment=LOGIFORGE_GIT_CACHE_DIR=/var/cache/logiforge-serve
ExecStart=/usr/local/bin/logiforge serve
Restart=on-failure
RestartSec=5s

# 書ける場所は、設定の DB と、作業用の git の複製だけである。置き場（/var/lib/logiforge/store）は、読むだけである（ProtectSystem=strict）。
# 3 つのディレクトリは、入れるときに作る（docs/adoption/linux-host/README.md）。
ReadWritePaths=/var/lib/logiforge/config
ReadOnlyPaths=/var/lib/logiforge/store
CacheDirectory=logiforge-serve
CacheDirectoryMode=0750
UMask=0027
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
